TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_channel_or_chat_id_here   # e.g. -100xxxxxxxxxx for a channel
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.8-flash
TRIAGE_THRESHOLD=7
# Messages shorter than this are ignored (too short to evaluate as a note).
MIN_NOTE_CHARS=40
# Optional: comma-separated Telegram numeric user IDs allowed to press buttons
# and run /autoapprove, /threshold, /settings. Empty = anyone in the channel.
ADMIN_USER_IDS=
# Related news (Google News RSS), attached only after a draft is approved.
NEWS_ENABLED=true
NEWS_MIN_RELEVANCE=6
NEWS_LOOKBACK_DAYS=30
NEWS_MAX_ITEMS=3
# --- Cloud deployment only (e.g. Railway). Leave unset for local dev. ---
# Absolute path to the SQLite file, on a mounted persistent volume.
# DATABASE_PATH=/data/skinstinct.db
# Comma-separated extra origins allowed to call the API (e.g. your Vercel URL).
# CORS_ORIGINS=https://your-app.vercel.app
